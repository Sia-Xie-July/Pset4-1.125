[{"end_seconds":4.88,"segment_id":"s-000001","start_seconds":0.8,"text":"I asked our model how much Priya owes"},{"end_seconds":6.8,"segment_id":"s-000002","start_seconds":3.28,"text":"for a late book."},{"end_seconds":9.92,"segment_id":"s-000003","start_seconds":4.88,"text":"With thinking switched off, it answered"},{"end_seconds":12.2,"segment_id":"s-000004","start_seconds":6.8,"text":"in a second, 5 rupees. Wrong. With"},{"end_seconds":14.28,"segment_id":"s-000005","start_seconds":9.92,"text":"thinking on, it thought for 8,000"},{"end_seconds":15.96,"segment_id":"s-000006","start_seconds":12.2,"text":"tokens, almost 9 minutes, and never"},{"end_seconds":18.32,"segment_id":"s-000007","start_seconds":14.28,"text":"answered at all."},{"end_seconds":20.84,"segment_id":"s-000008","start_seconds":15.96,"text":"You'll see why and how to choose a model"},{"end_seconds":23.04,"segment_id":"s-000009","start_seconds":18.32,"text":"for an agent."},{"end_seconds":25.68,"segment_id":"s-000010","start_seconds":20.84,"text":"In lecture one, we pinned down what an"},{"end_seconds":28.0,"segment_id":"s-000011","start_seconds":23.04,"text":"agent is, a model that runs tools in a"},{"end_seconds":30.32,"segment_id":"s-000012","start_seconds":25.68,"text":"loop until the job's done."},{"end_seconds":32.759,"segment_id":"s-000013","start_seconds":28.0,"text":"Today, the kinds of agents people build"},{"end_seconds":34.6,"segment_id":"s-000014","start_seconds":30.32,"text":"with it, the model inside, and what"},{"end_seconds":37.52,"segment_id":"s-000015","start_seconds":32.759,"text":"changes when an agent keeps working"},{"end_seconds":39.84,"segment_id":"s-000016","start_seconds":34.6,"text":"after you've gone home."},{"end_seconds":42.2,"segment_id":"s-000017","start_seconds":37.52,"text":"The book borrows seven practical agent"},{"end_seconds":43.8,"segment_id":"s-000018","start_seconds":39.84,"text":"types from a tech news site and adds"},{"end_seconds":46.2,"segment_id":"s-000019","start_seconds":42.2,"text":"voice and video."},{"end_seconds":48.32,"segment_id":"s-000020","start_seconds":43.8,"text":"I'd rather group them by what they do."},{"end_seconds":50.48,"segment_id":"s-000021","start_seconds":46.2,"text":"Assistants talk with one person, look"},{"end_seconds":52.68,"segment_id":"s-000022","start_seconds":48.32,"text":"things up, and act for them. Analytics"},{"end_seconds":55.04,"segment_id":"s-000023","start_seconds":50.48,"text":"bots and expert agents for law or"},{"end_seconds":56.88,"segment_id":"s-000024","start_seconds":52.68,"text":"medicine are mostly assistants pointed"},{"end_seconds":59.12,"segment_id":"s-000025","start_seconds":55.04,"text":"at special data."},{"end_seconds":61.8,"segment_id":"s-000026","start_seconds":56.88,"text":"Coding agents read a repository, edit"},{"end_seconds":64.199,"segment_id":"s-000027","start_seconds":59.12,"text":"files, and run the tests. Research"},{"end_seconds":66.88,"segment_id":"s-000028","start_seconds":61.8,"text":"agents search, read dozens of sources,"},{"end_seconds":69.28,"segment_id":"s-000029","start_seconds":64.199,"text":"and write a report with citations."},{"end_seconds":71.56,"segment_id":"s-000030","start_seconds":66.88,"text":"Computer use agents operate a browser or"},{"end_seconds":74.4,"segment_id":"s-000031","start_seconds":69.28,"text":"a desktop the way you would, which makes"},{"end_seconds":75.76,"segment_id":"s-000032","start_seconds":71.56,"text":"every page they read untrusted input."},{"end_seconds":78.36,"segment_id":"s-000033","start_seconds":74.4,"text":"And background agents start on a"},{"end_seconds":81.76,"segment_id":"s-000034","start_seconds":75.76,"text":"trigger, work in a sandbox, and hand"},{"end_seconds":83.96,"segment_id":"s-000035","start_seconds":78.36,"text":"back a result like a pull request."},{"end_seconds":86.0,"segment_id":"s-000036","start_seconds":81.76,"text":"Voice and video aren't separate kinds."},{"end_seconds":87.8,"segment_id":"s-000037","start_seconds":83.96,"text":"They're ways to talk to any of these,"},{"end_seconds":89.64,"segment_id":"s-000038","start_seconds":86.0,"text":"covered in part three."},{"end_seconds":91.6,"segment_id":"s-000039","start_seconds":87.8,"text":"Classic business automations are mostly"},{"end_seconds":94.16,"segment_id":"s-000040","start_seconds":89.64,"text":"fixed workflows, and lecture three"},{"end_seconds":96.04,"segment_id":"s-000041","start_seconds":91.6,"text":"decides when that's all you need."},{"end_seconds":98.0,"segment_id":"s-000042","start_seconds":94.16,"text":"Like the book, we'll focus on agents"},{"end_seconds":100.44,"segment_id":"s-000043","start_seconds":96.04,"text":"built around language models working in"},{"end_seconds":102.88,"segment_id":"s-000044","start_seconds":98.0,"text":"text and code."},{"end_seconds":104.84,"segment_id":"s-000045","start_seconds":100.44,"text":"Of these five, coding agents took off"},{"end_seconds":106.76,"segment_id":"s-000046","start_seconds":102.88,"text":"first, and the reasons tell you what"},{"end_seconds":108.68,"segment_id":"s-000047","start_seconds":104.84,"text":"makes any agent work."},{"end_seconds":110.32,"segment_id":"s-000048","start_seconds":106.76,"text":"Code is text, which is what models"},{"end_seconds":113.08,"segment_id":"s-000049","start_seconds":108.68,"text":"handle best."},{"end_seconds":115.32,"segment_id":"s-000050","start_seconds":110.32,"text":"More important, code has a verifier."},{"end_seconds":117.28,"segment_id":"s-000051","start_seconds":113.08,"text":"Tests and compilers say right or wrong"},{"end_seconds":119.0,"segment_id":"s-000052","start_seconds":115.32,"text":"in seconds for free."},{"end_seconds":121.28,"segment_id":"s-000053","start_seconds":117.28,"text":"That's also why models could be trained"},{"end_seconds":123.36,"segment_id":"s-000054","start_seconds":119.0,"text":"on coding with reinforcement learning."},{"end_seconds":126.12,"segment_id":"s-000055","start_seconds":121.28,"text":"The reward is checkable."},{"end_seconds":127.92,"segment_id":"s-000056","start_seconds":123.36,"text":"A repository is a sandbox. If the agent"},{"end_seconds":128.84,"segment_id":"s-000057","start_seconds":126.12,"text":"breaks something, you throw the copy"},{"end_seconds":130.759,"segment_id":"s-000058","start_seconds":127.92,"text":"away."},{"end_seconds":133.0,"segment_id":"s-000059","start_seconds":128.84,"text":"And the result arrives as a diff, the"},{"end_seconds":134.76,"segment_id":"s-000060","start_seconds":130.759,"text":"format developers already review every"},{"end_seconds":136.6,"segment_id":"s-000061","start_seconds":133.0,"text":"day."},{"end_seconds":138.72,"segment_id":"s-000062","start_seconds":134.76,"text":"The adoption is real."},{"end_seconds":141.6,"segment_id":"s-000063","start_seconds":136.6,"text":"In Stack Overflow's 2026 developer"},{"end_seconds":144.92,"segment_id":"s-000064","start_seconds":138.72,"text":"survey published on the 6th of October,"},{"end_seconds":147.08,"segment_id":"s-000065","start_seconds":141.6,"text":"66% of developers who use AI said they"},{"end_seconds":149.28,"segment_id":"s-000066","start_seconds":144.92,"text":"would work with coding agents."},{"end_seconds":152.12,"segment_id":"s-000067","start_seconds":147.08,"text":"Measuring the benefit is harder."},{"end_seconds":154.52,"segment_id":"s-000068","start_seconds":149.28,"text":"In 2025, a controlled study by Meta"},{"end_seconds":157.6,"segment_id":"s-000069","start_seconds":152.12,"text":"found experienced open-source developers"},{"end_seconds":160.12,"segment_id":"s-000070","start_seconds":154.52,"text":"were 19% slower with AI tools."},{"end_seconds":162.08,"segment_id":"s-000071","start_seconds":157.6,"text":"Its 2026 follow-up calls its own new"},{"end_seconds":164.28,"segment_id":"s-000072","start_seconds":160.12,"text":"estimate unreliable because many"},{"end_seconds":165.28,"segment_id":"s-000073","start_seconds":162.08,"text":"developers refuse to work without AI at"},{"end_seconds":167.16,"segment_id":"s-000074","start_seconds":164.28,"text":"all."},{"end_seconds":169.88,"segment_id":"s-000075","start_seconds":165.28,"text":"So, when someone quotes you a speed up,"},{"end_seconds":172.28,"segment_id":"s-000076","start_seconds":167.16,"text":"ask how it was measured."},{"end_seconds":175.08,"segment_id":"s-000077","start_seconds":169.88,"text":"Let's build a tiny one. The library's"},{"end_seconds":176.36,"segment_id":"s-000078","start_seconds":172.28,"text":"fine calculator has a bug filed as issue"},{"end_seconds":178.48,"segment_id":"s-000079","start_seconds":175.08,"text":"241."},{"end_seconds":180.56,"segment_id":"s-000080","start_seconds":176.36,"text":"A book due on a closed day should be due"},{"end_seconds":182.72,"segment_id":"s-000081","start_seconds":178.48,"text":"on the next open day, but students are"},{"end_seconds":185.28,"segment_id":"s-000082","start_seconds":180.56,"text":"fined from the closed day."},{"end_seconds":188.16,"segment_id":"s-000083","start_seconds":182.72,"text":"Our agent gets three tools: read a file,"},{"end_seconds":190.2,"segment_id":"s-000084","start_seconds":185.28,"text":"write a file, and run the tests."},{"end_seconds":192.88,"segment_id":"s-000085","start_seconds":188.16,"text":"Then it's the loop from lecture one. The"},{"end_seconds":195.16,"segment_id":"s-000086","start_seconds":190.2,"text":"model calls tools until it's done."},{"end_seconds":196.6,"segment_id":"s-000087","start_seconds":192.88,"text":"When it stops, our code runs the tests"},{"end_seconds":199.16,"segment_id":"s-000088","start_seconds":195.16,"text":"again itself."},{"end_seconds":200.88,"segment_id":"s-000089","start_seconds":196.6,"text":"It doesn't take the agent's word for it."},{"end_seconds":203.4,"segment_id":"s-000090","start_seconds":199.16,"text":"And it builds the diff a reviewer will"},{"end_seconds":205.2,"segment_id":"s-000091","start_seconds":200.88,"text":"read in the morning."},{"end_seconds":206.72,"segment_id":"s-000092","start_seconds":203.4,"text":"Here's the real run."},{"end_seconds":209.04,"segment_id":"s-000093","start_seconds":205.2,"text":"The issue goes in."},{"end_seconds":211.959,"segment_id":"s-000094","start_seconds":206.72,"text":"The model's first move is to read both"},{"end_seconds":213.0,"segment_id":"s-000095","start_seconds":209.04,"text":"files, the code and the tests, in one"},{"end_seconds":215.6,"segment_id":"s-000096","start_seconds":211.959,"text":"turn."},{"end_seconds":218.36,"segment_id":"s-000097","start_seconds":213.0,"text":"Then, before changing anything, it runs"},{"end_seconds":219.92,"segment_id":"s-000098","start_seconds":215.6,"text":"the tests and sees two failures, both"},{"end_seconds":222.0,"segment_id":"s-000099","start_seconds":218.36,"text":"closed day cases."},{"end_seconds":223.92,"segment_id":"s-000100","start_seconds":219.92,"text":"That's what a good engineer does first,"},{"end_seconds":226.64,"segment_id":"s-000101","start_seconds":222.0,"text":"reproduce the bug."},{"end_seconds":228.44,"segment_id":"s-000102","start_seconds":223.92,"text":"Next, it rewrites the fines file, moving"},{"end_seconds":229.64,"segment_id":"s-000103","start_seconds":226.64,"text":"the due date to the next open day before"},{"end_seconds":232.239,"segment_id":"s-000104","start_seconds":228.44,"text":"counting."},{"end_seconds":234.76,"segment_id":"s-000105","start_seconds":229.64,"text":"It runs the tests again, four passed,"},{"end_seconds":236.6,"segment_id":"s-000106","start_seconds":232.239,"text":"and it writes the pull request."},{"end_seconds":238.72,"segment_id":"s-000107","start_seconds":234.76,"text":"As a loop, that's five turns of the"},{"end_seconds":241.0,"segment_id":"s-000108","start_seconds":236.6,"text":"model and five tool calls."},{"end_seconds":243.2,"segment_id":"s-000109","start_seconds":238.72,"text":"Nobody told it to read the tests first"},{"end_seconds":245.6,"segment_id":"s-000110","start_seconds":241.0,"text":"or to run them before the fix. It chose"},{"end_seconds":247.8,"segment_id":"s-000111","start_seconds":243.2,"text":"those steps."},{"end_seconds":250.48,"segment_id":"s-000112","start_seconds":245.6,"text":"Here's the change the reviewer gets, one"},{"end_seconds":252.2,"segment_id":"s-000113","start_seconds":247.8,"text":"line out, three lines in. The due date"},{"end_seconds":253.76,"segment_id":"s-000114","start_seconds":250.48,"text":"goes through next open day before the"},{"end_seconds":256.72,"segment_id":"s-000115","start_seconds":252.2,"text":"subtraction."},{"end_seconds":258.72,"segment_id":"s-000116","start_seconds":253.76,"text":"Now, worth catching, in its explanation,"},{"end_seconds":260.04,"segment_id":"s-000117","start_seconds":256.72,"text":"the model called the 18th of October a"},{"end_seconds":262.52,"segment_id":"s-000118","start_seconds":258.72,"text":"Saturday."},{"end_seconds":264.72,"segment_id":"s-000119","start_seconds":260.04,"text":"It's a Sunday. The code's right anyway,"},{"end_seconds":267.72,"segment_id":"s-000120","start_seconds":262.52,"text":"because the tests check the code, not"},{"end_seconds":270.919,"segment_id":"s-000121","start_seconds":264.72,"text":"the story. A verifier checks behavior. A"},{"end_seconds":273.72,"segment_id":"s-000122","start_seconds":267.72,"text":"person still reads the words."},{"end_seconds":275.919,"segment_id":"s-000123","start_seconds":270.919,"text":"The run summary, four tests passed."},{"end_seconds":278.96,"segment_id":"s-000124","start_seconds":273.72,"text":"Five model turns, about 5 and 1/2"},{"end_seconds":282.64,"segment_id":"s-000125","start_seconds":275.919,"text":"thousand tokens in, 500 out, and 2"},{"end_seconds":285.2,"segment_id":"s-000126","start_seconds":278.96,"text":"minutes of model time on this laptop."},{"end_seconds":287.68,"segment_id":"s-000127","start_seconds":282.64,"text":"Notice how little of that was the model."},{"end_seconds":289.64,"segment_id":"s-000128","start_seconds":285.2,"text":"It read, decided, and wrote."},{"end_seconds":292.52,"segment_id":"s-000129","start_seconds":287.68,"text":"Everything around it is what people now"},{"end_seconds":294.88,"segment_id":"s-000130","start_seconds":289.64,"text":"call the harness, the loop, the tools,"},{"end_seconds":296.0,"segment_id":"s-000131","start_seconds":292.52,"text":"the context, what the model sees on each"},{"end_seconds":298.12,"segment_id":"s-000132","start_seconds":294.88,"text":"turn."},{"end_seconds":299.6,"segment_id":"s-000133","start_seconds":296.0,"text":"A sandbox, a copy of the code it's"},{"end_seconds":300.76,"segment_id":"s-000134","start_seconds":298.12,"text":"allowed to break."},{"end_seconds":302.68,"segment_id":"s-000135","start_seconds":299.6,"text":"Permissions,"},{"end_seconds":305.12,"segment_id":"s-000136","start_seconds":300.76,"text":"our write file tool refuses to touch the"},{"end_seconds":306.56,"segment_id":"s-000137","start_seconds":302.68,"text":"tests, so the agent can't make them pass"},{"end_seconds":308.44,"segment_id":"s-000138","start_seconds":305.12,"text":"by editing them."},{"end_seconds":310.48,"segment_id":"s-000139","start_seconds":306.56,"text":"And a verifier that decides when the"},{"end_seconds":312.64,"segment_id":"s-000140","start_seconds":308.44,"text":"work's really done."},{"end_seconds":314.56,"segment_id":"s-000141","start_seconds":310.48,"text":"This matters when you choose a model."},{"end_seconds":316.8,"segment_id":"s-000142","start_seconds":312.64,"text":"Coding leaderboards now list the agent"},{"end_seconds":318.48,"segment_id":"s-000143","start_seconds":314.56,"text":"and the model separately, because one"},{"end_seconds":320.2,"segment_id":"s-000144","start_seconds":316.8,"text":"model scores very differently in"},{"end_seconds":321.96,"segment_id":"s-000145","start_seconds":318.48,"text":"different harnesses."},{"end_seconds":324.4,"segment_id":"s-000146","start_seconds":320.2,"text":"Lecture four maps the vendors' own"},{"end_seconds":326.56,"segment_id":"s-000147","start_seconds":321.96,"text":"harnesses."},{"end_seconds":328.84,"segment_id":"s-000148","start_seconds":324.4,"text":"That agent didn't need anyone watching,"},{"end_seconds":330.72,"segment_id":"s-000149","start_seconds":326.56,"text":"and that's the bigger shift."},{"end_seconds":332.6,"segment_id":"s-000150","start_seconds":328.84,"text":"Ordinary software is synchronous. You"},{"end_seconds":335.04,"segment_id":"s-000151","start_seconds":330.72,"text":"ask, and you wait."},{"end_seconds":337.72,"segment_id":"s-000152","start_seconds":332.6,"text":"An agent can work asynchronously on many"},{"end_seconds":339.6,"segment_id":"s-000153","start_seconds":335.04,"text":"tasks at once while you're away."},{"end_seconds":341.36,"segment_id":"s-000154","start_seconds":337.72,"text":"A trigger starts it, like an issue"},{"end_seconds":344.0,"segment_id":"s-000155","start_seconds":339.6,"text":"assigned at night."},{"end_seconds":346.08,"segment_id":"s-000156","start_seconds":341.36,"text":"It works in a sandbox with tools and no"},{"end_seconds":348.36,"segment_id":"s-000157","start_seconds":344.0,"text":"secrets. Before morning, there's an"},{"end_seconds":349.32,"segment_id":"s-000158","start_seconds":346.08,"text":"artifact, a pull request with passing"},{"end_seconds":352.08,"segment_id":"s-000159","start_seconds":348.36,"text":"tests."},{"end_seconds":354.8,"segment_id":"s-000160","start_seconds":349.32,"text":"At 9:00, a person reviews it. GitHub's"},{"end_seconds":356.68,"segment_id":"s-000161","start_seconds":352.08,"text":"Copilot Cloud Agent, OpenAI's Codex, and"},{"end_seconds":357.96,"segment_id":"s-000162","start_seconds":354.8,"text":"Cursor's Cloud Agents all work this way"},{"end_seconds":360.28,"segment_id":"s-000163","start_seconds":356.68,"text":"today."},{"end_seconds":362.36,"segment_id":"s-000164","start_seconds":357.96,"text":"Picture it at our library. The librarian"},{"end_seconds":365.04,"segment_id":"s-000165","start_seconds":360.28,"text":"arrives to find last night's emails with"},{"end_seconds":367.16,"segment_id":"s-000166","start_seconds":362.36,"text":"replies drafted and renewals proposed,"},{"end_seconds":369.52,"segment_id":"s-000167","start_seconds":365.04,"text":"each waiting for a click."},{"end_seconds":371.64,"segment_id":"s-000168","start_seconds":367.16,"text":"You stop doing every step and start"},{"end_seconds":373.44,"segment_id":"s-000169","start_seconds":369.52,"text":"reviewing finished work, planning ahead"},{"end_seconds":376.72,"segment_id":"s-000170","start_seconds":371.64,"text":"instead of reacting."},{"end_seconds":376.72,"segment_id":"s-000171","start_seconds":373.44,"text":"Lecture 14 builds this."},{"end_seconds":381.32,"segment_id":"s-000172","start_seconds":376.76,"text":"The book grounds itself in seven example"},{"end_seconds":383.6,"segment_id":"s-000173","start_seconds":378.919,"text":"agents with evaluation sets, from"},{"end_seconds":385.72,"segment_id":"s-000174","start_seconds":381.32,"text":"customer support and finance to legal"},{"end_seconds":387.56,"segment_id":"s-000175","start_seconds":383.6,"text":"review and supply chains."},{"end_seconds":390.84,"segment_id":"s-000176","start_seconds":385.72,"text":"The most established areas today are"},{"end_seconds":393.4,"segment_id":"s-000177","start_seconds":387.56,"text":"coding, support, and research."},{"end_seconds":395.919,"segment_id":"s-000178","start_seconds":390.84,"text":"In regulated work like health, law, and"},{"end_seconds":398.52,"segment_id":"s-000179","start_seconds":393.4,"text":"finance, the agent drafts and a person"},{"end_seconds":400.4,"segment_id":"s-000180","start_seconds":395.919,"text":"signs off with an audit trail."},{"end_seconds":402.6,"segment_id":"s-000181","start_seconds":398.52,"text":"This course uses one fictional college"},{"end_seconds":405.48,"segment_id":"s-000182","start_seconds":400.4,"text":"instead, from the library help desk to"},{"end_seconds":408.6,"segment_id":"s-000183","start_seconds":402.6,"text":"claim pilot, an expense claims agent."},{"end_seconds":410.88,"segment_id":"s-000184","start_seconds":405.48,"text":"Every one of them gets tested."},{"end_seconds":413.6,"segment_id":"s-000185","start_seconds":408.6,"text":"So, which model goes inside?"},{"end_seconds":416.68,"segment_id":"s-000186","start_seconds":410.88,"text":"As listed on the 10th of October 2026,"},{"end_seconds":419.72,"segment_id":"s-000187","start_seconds":413.6,"text":"the small fast tier, GPT-6 Luna and"},{"end_seconds":422.04,"segment_id":"s-000188","start_seconds":416.68,"text":"Anthropic's Haiku 5.5, costs 10 cents"},{"end_seconds":423.72,"segment_id":"s-000189","start_seconds":419.72,"text":"per million input tokens and 50 cents"},{"end_seconds":426.48,"segment_id":"s-000190","start_seconds":422.04,"text":"per million output."},{"end_seconds":431.08,"segment_id":"s-000191","start_seconds":423.72,"text":"The middle tier, GPT-6.1 Saul and Sonnet"},{"end_seconds":434.12,"segment_id":"s-000192","start_seconds":426.48,"text":"5.5, is $2 in and 10 out. Opus 5.5 is 4"},{"end_seconds":438.32,"segment_id":"s-000193","start_seconds":431.08,"text":"and 20. The most capable GPT-6 Astra and"},{"end_seconds":441.2,"segment_id":"s-000194","start_seconds":434.12,"text":"Fable 5.1 cost 10 and 50. For output,"},{"end_seconds":444.68,"segment_id":"s-000195","start_seconds":438.32,"text":"that's 100 times the cheapest tier."},{"end_seconds":446.919,"segment_id":"s-000196","start_seconds":441.2,"text":"Then there are open weights. Qwen 3.5, 9"},{"end_seconds":449.04,"segment_id":"s-000197","start_seconds":444.68,"text":"billion parameters, Apache licensed,"},{"end_seconds":452.12,"segment_id":"s-000198","start_seconds":446.919,"text":"released early this year, runs every"},{"end_seconds":454.56,"segment_id":"s-000199","start_seconds":449.04,"text":"demo in this course on a 16 GB laptop."},{"end_seconds":456.2,"segment_id":"s-000200","start_seconds":452.12,"text":"You pay for hardware instead of tokens."},{"end_seconds":457.88,"segment_id":"s-000201","start_seconds":454.56,"text":"Small models got this good through"},{"end_seconds":459.68,"segment_id":"s-000202","start_seconds":456.2,"text":"distillation from bigger ones,"},{"end_seconds":461.0,"segment_id":"s-000203","start_seconds":457.88,"text":"quantization, and synthetic training"},{"end_seconds":463.24,"segment_id":"s-000204","start_seconds":459.68,"text":"data."},{"end_seconds":465.64,"segment_id":"s-000205","start_seconds":461.0,"text":"Most of the hosted models on this slide"},{"end_seconds":469.64,"segment_id":"s-000206","start_seconds":463.24,"text":"are less than 6 weeks old. So, don't"},{"end_seconds":472.4,"segment_id":"s-000207","start_seconds":465.64,"text":"memorize the list. Learn how to choose."},{"end_seconds":474.04,"segment_id":"s-000208","start_seconds":469.64,"text":"The book's advice still holds. Start"},{"end_seconds":476.12,"segment_id":"s-000209","start_seconds":472.4,"text":"with a strong general model from a"},{"end_seconds":478.24,"segment_id":"s-000210","start_seconds":474.04,"text":"leading provider and get the agent"},{"end_seconds":480.8,"segment_id":"s-000211","start_seconds":476.12,"text":"working first. The book's leaderboard"},{"end_seconds":483.44,"segment_id":"s-000212","start_seconds":478.24,"text":"from August 2025, topped by a mini"},{"end_seconds":486.72,"segment_id":"s-000213","start_seconds":480.8,"text":"model, already looks old and that proves"},{"end_seconds":488.24,"segment_id":"s-000214","start_seconds":483.44,"text":"the point. Rankings move every month."},{"end_seconds":489.84,"segment_id":"s-000215","start_seconds":486.72,"text":"So, write a few tests from real"},{"end_seconds":492.0,"segment_id":"s-000216","start_seconds":488.24,"text":"requests."},{"end_seconds":494.0,"segment_id":"s-000217","start_seconds":489.84,"text":"Then try cheaper and smaller models"},{"end_seconds":496.28,"segment_id":"s-000218","start_seconds":492.0,"text":"against your own tests, maybe with"},{"end_seconds":498.96,"segment_id":"s-000219","start_seconds":494.0,"text":"retrieval or fine-tuning, and keep the"},{"end_seconds":501.4,"segment_id":"s-000220","start_seconds":496.28,"text":"cheapest one that passes. And wrote,"},{"end_seconds":503.4,"segment_id":"s-000221","start_seconds":498.96,"text":"\"Easy requests to a small fast model,"},{"end_seconds":505.68,"segment_id":"s-000222","start_seconds":501.4,"text":"hard ones to a big one.\""},{"end_seconds":508.44,"segment_id":"s-000223","start_seconds":503.4,"text":"The future is many models, so keep yours"},{"end_seconds":511.64,"segment_id":"s-000224","start_seconds":505.68,"text":"behind one small interface you can swap."},{"end_seconds":514.4,"segment_id":"s-000225","start_seconds":508.44,"text":"Lecture 7 does this properly."},{"end_seconds":516.0,"segment_id":"s-000226","start_seconds":511.64,"text":"One more dial and people get it wrong."},{"end_seconds":519.039,"segment_id":"s-000227","start_seconds":514.4,"text":"Many models can think before they"},{"end_seconds":522.0,"segment_id":"s-000228","start_seconds":516.0,"text":"answer. They write out reasoning first."},{"end_seconds":523.84,"segment_id":"s-000229","start_seconds":519.039,"text":"Given 3.5 does it by default. Here I"},{"end_seconds":526.04,"segment_id":"s-000230","start_seconds":522.0,"text":"send the same question with think set to"},{"end_seconds":528.12,"segment_id":"s-000231","start_seconds":523.84,"text":"false, then to true."},{"end_seconds":530.08,"segment_id":"s-000232","start_seconds":526.04,"text":"I record the tokens it generates and the"},{"end_seconds":531.64,"segment_id":"s-000233","start_seconds":528.12,"text":"time the model measured."},{"end_seconds":532.839,"segment_id":"s-000234","start_seconds":530.08,"text":"Three questions about the library's"},{"end_seconds":535.08,"segment_id":"s-000235","start_seconds":531.64,"text":"rules."},{"end_seconds":538.48,"segment_id":"s-000236","start_seconds":532.839,"text":"Is it open on Sundays? What does Priya"},{"end_seconds":540.56,"segment_id":"s-000237","start_seconds":535.08,"text":"owe 4 days late? And what does Arjun owe"},{"end_seconds":542.64,"segment_id":"s-000238","start_seconds":538.48,"text":"when his due date falls on a Sunday and"},{"end_seconds":545.2,"segment_id":"s-000239","start_seconds":540.56,"text":"the next day is closed, too?"},{"end_seconds":547.4,"segment_id":"s-000240","start_seconds":542.64,"text":"The right answers are no, 20 rupees, and"},{"end_seconds":550.839,"segment_id":"s-000241","start_seconds":545.2,"text":"15."},{"end_seconds":554.72,"segment_id":"s-000242","start_seconds":547.4,"text":"The easy one, both modes say no. Without"},{"end_seconds":557.48,"segment_id":"s-000243","start_seconds":550.839,"text":"thinking, two tokens. With thinking, 268"},{"end_seconds":558.839,"segment_id":"s-000244","start_seconds":554.72,"text":"tokens first. Same answer, many times"},{"end_seconds":561.92,"segment_id":"s-000245","start_seconds":557.48,"text":"the cost."},{"end_seconds":563.96,"segment_id":"s-000246","start_seconds":558.839,"text":"Priya's fine without thinking, five."},{"end_seconds":564.88,"segment_id":"s-000247","start_seconds":561.92,"text":"That isn't her fine. It's the rate per"},{"end_seconds":568.2,"segment_id":"s-000248","start_seconds":563.96,"text":"day."},{"end_seconds":570.76,"segment_id":"s-000249","start_seconds":564.88,"text":"With thinking, no answer at all, 8,077"},{"end_seconds":571.72,"segment_id":"s-000250","start_seconds":568.2,"text":"tokens and our 8,000 token window ran"},{"end_seconds":573.96,"segment_id":"s-000251","start_seconds":570.76,"text":"out."},{"end_seconds":576.52,"segment_id":"s-000252","start_seconds":571.72,"text":"Here's why, in its own words."},{"end_seconds":579.0,"segment_id":"s-000253","start_seconds":573.96,"text":"It worked out 20 early on. Then it"},{"end_seconds":580.8,"segment_id":"s-000254","start_seconds":576.52,"text":"noticed the library's closed on Sunday"},{"end_seconds":583.68,"segment_id":"s-000255","start_seconds":579.0,"text":"and couldn't decide whether a closed day"},{"end_seconds":585.96,"segment_id":"s-000256","start_seconds":580.8,"text":"counts. If I answer 20 and the intended"},{"end_seconds":587.8,"segment_id":"s-000257","start_seconds":583.68,"text":"answer is 15, I fail."},{"end_seconds":589.24,"segment_id":"s-000258","start_seconds":585.96,"text":"It went round that loop until the room"},{"end_seconds":591.4,"segment_id":"s-000259","start_seconds":587.8,"text":"ran out."},{"end_seconds":594.4,"segment_id":"s-000260","start_seconds":589.24,"text":"Arjun's harder fine, thinking off says"},{"end_seconds":596.84,"segment_id":"s-000261","start_seconds":591.4,"text":"five again. Thinking on gets 15, right?"},{"end_seconds":599.12,"segment_id":"s-000262","start_seconds":594.4,"text":"After about 2 and 1/2 thousand tokens,"},{"end_seconds":601.28,"segment_id":"s-000263","start_seconds":596.84,"text":"then I fix the rule, not the model."},{"end_seconds":603.72,"segment_id":"s-000264","start_seconds":599.12,"text":"Every calendar day counts, closed days"},{"end_seconds":605.88,"segment_id":"s-000265","start_seconds":601.28,"text":"included. Now thinking gets 20. Thinking"},{"end_seconds":607.68,"segment_id":"s-000266","start_seconds":603.72,"text":"off still says five."},{"end_seconds":609.32,"segment_id":"s-000267","start_seconds":605.88,"text":"Look at the tokens thinking bought the"},{"end_seconds":610.92,"segment_id":"s-000268","start_seconds":607.68,"text":"right answers at hundreds or thousands"},{"end_seconds":612.68,"segment_id":"s-000269","start_seconds":609.32,"text":"of times the cost."},{"end_seconds":614.52,"segment_id":"s-000270","start_seconds":610.92,"text":"The seconds include loading the model on"},{"end_seconds":616.88,"segment_id":"s-000271","start_seconds":612.68,"text":"a shared laptop, so tokens are the"},{"end_seconds":619.2,"segment_id":"s-000272","start_seconds":614.52,"text":"honest measure."},{"end_seconds":620.76,"segment_id":"s-000273","start_seconds":616.88,"text":"That makes a good interview question."},{"end_seconds":621.84,"segment_id":"s-000274","start_seconds":619.2,"text":"When would you turn a model's thinking"},{"end_seconds":624.08,"segment_id":"s-000275","start_seconds":620.76,"text":"off?"},{"end_seconds":626.68,"segment_id":"s-000276","start_seconds":621.84,"text":"For easy, frequent steps, like picking a"},{"end_seconds":629.56,"segment_id":"s-000277","start_seconds":624.08,"text":"tool or labeling an email off, because"},{"end_seconds":632.52,"segment_id":"s-000278","start_seconds":626.68,"text":"you pay for every token on every call."},{"end_seconds":634.56,"segment_id":"s-000279","start_seconds":629.56,"text":"For hard, rare decisions, on with room"},{"end_seconds":636.8,"segment_id":"s-000280","start_seconds":632.52,"text":"to finish and with rules written so they"},{"end_seconds":639.44,"segment_id":"s-000281","start_seconds":634.56,"text":"can't be read two ways."},{"end_seconds":641.8,"segment_id":"s-000282","start_seconds":636.8,"text":"Hosted models give you finer dials, like"},{"end_seconds":644.28,"segment_id":"s-000283","start_seconds":639.44,"text":"OpenAI's reasoning effort or Gemini's"},{"end_seconds":646.56,"segment_id":"s-000284","start_seconds":641.8,"text":"thinking level. And some flagships can't"},{"end_seconds":649.16,"segment_id":"s-000285","start_seconds":644.28,"text":"switch thinking off at all."},{"end_seconds":651.6,"segment_id":"s-000286","start_seconds":646.56,"text":"Lecture 16 shows how thinking travels"},{"end_seconds":654.52,"segment_id":"s-000287","start_seconds":649.16,"text":"with tool calls."},{"end_seconds":656.92,"segment_id":"s-000288","start_seconds":651.6,"text":"Let's recap. Five kinds of agents,"},{"end_seconds":658.56,"segment_id":"s-000289","start_seconds":654.52,"text":"assistants, coding, research, computer"},{"end_seconds":660.08,"segment_id":"s-000290","start_seconds":656.92,"text":"use, and background."},{"end_seconds":662.92,"segment_id":"s-000291","start_seconds":658.56,"text":"Coding went first because it has a"},{"end_seconds":664.44,"segment_id":"s-000292","start_seconds":660.08,"text":"verifier, a sandbox, and diffs a person"},{"end_seconds":666.4,"segment_id":"s-000293","start_seconds":662.92,"text":"can review."},{"end_seconds":668.32,"segment_id":"s-000294","start_seconds":664.44,"text":"The harness around a model matters as"},{"end_seconds":670.76,"segment_id":"s-000295","start_seconds":666.4,"text":"much as the model. And you choose a"},{"end_seconds":672.8,"segment_id":"s-000296","start_seconds":668.32,"text":"model with your own tests, date stamped,"},{"end_seconds":675.12,"segment_id":"s-000297","start_seconds":670.76,"text":"treating thinking as a dial that costs"},{"end_seconds":676.4,"segment_id":"s-000298","start_seconds":672.8,"text":"real tokens."},{"end_seconds":678.64,"segment_id":"s-000299","start_seconds":675.12,"text":"Your turn."},{"end_seconds":681.32,"segment_id":"s-000300","start_seconds":676.4,"text":"An agent makes about 200 quick tool"},{"end_seconds":683.04,"segment_id":"s-000301","start_seconds":678.64,"text":"choice calls and one hard planning call"},{"end_seconds":684.88,"segment_id":"s-000302","start_seconds":681.32,"text":"for every task."},{"end_seconds":687.56,"segment_id":"s-000303","start_seconds":683.04,"text":"Where should thinking be on?"},{"end_seconds":691.4,"segment_id":"s-000304","start_seconds":684.88,"text":"Every call? Only the planning call? Only"},{"end_seconds":691.4,"segment_id":"s-000305","start_seconds":687.56,"text":"the tool choice calls? Or nowhere?"},{"end_seconds":699.88,"segment_id":"s-000306","start_seconds":695.08,"text":">> Only on the planning call, thinking on"},{"end_seconds":702.48,"segment_id":"s-000307","start_seconds":697.32,"text":"the quick calls means paying for it 200"},{"end_seconds":703.76,"segment_id":"s-000308","start_seconds":699.88,"text":"times on choices the model already gets"},{"end_seconds":706.0,"segment_id":"s-000309","start_seconds":702.48,"text":"right."},{"end_seconds":709.88,"segment_id":"s-000310","start_seconds":703.76,"text":"On the one hard decision, it can pay for"},{"end_seconds":711.04,"segment_id":"s-000311","start_seconds":706.0,"text":"itself as long as it has room to finish."},{"end_seconds":713.08,"segment_id":"s-000312","start_seconds":709.88,"text":"Next time,"},{"end_seconds":715.56,"segment_id":"s-000313","start_seconds":711.04,"text":"do you even need an agent?"},{"end_seconds":717.84,"segment_id":"s-000314","start_seconds":713.08,"text":"One library problem solved four ways"},{"end_seconds":722.08,"segment_id":"s-000315","start_seconds":715.56,"text":"with plain code, a workflow, rag, and an"},{"end_seconds":722.08,"segment_id":"s-000316","start_seconds":717.84,"text":"agent, each one measured. See you there."}]
